# ── Application ──
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# ── PostgreSQL (async) ──
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/interview_guide

# ── Redis ──
REDIS_URL=redis://localhost:6379/0
# Max connections in Redis connection pool (default 50)
REDIS_MAX_CONNECTIONS=50

# ── S3 / MinIO ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=interview-guide
S3_REGION=us-east-1

# ── AI / LLM ──
# 仅首次启动且 DB 无 provider 时 seed 注入（需同时配置 APP_AI_CONFIG_ENCRYPTION_KEY 才能加密落库）；
# 运行时以数据库为准，改环境变量对已 seed 的库不生效（需清空 llm_providers 表重新 seed）
AI_BAILIAN_API_KEY=your-api-key-here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen3.5-flash

# ── CORS ──
# Comma-separated list, e.g. http://localhost:5173,http://localhost:5174
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# ── Voice ──
VOICE_ASR_LANGUAGE=zh-CN
VOICE_TTS_VOICE=longxiaochun
VOICE_SESSION_IDLE_TIMEOUT=120
VOICE_RECONNECT_TIMEOUT=30
# Max concurrent WebSocket connections for voice interviews (default 10, single-worker only)
VOICE_MAX_WS_CONNECTIONS=10

# ── Rate Limiting ──
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_PER_IP=30
RATE_LIMIT_PER_USER=60

# ── Security ──
SECRET_KEY=change-me-to-a-random-string
# Must be base64-encoded 32-byte key. Generate with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
APP_AI_CONFIG_ENCRYPTION_KEY=
# 管理员登录凭据（两者均未配置 = 降级无认证，任意账号可签发 token；配置后 login 必须完全匹配）。
# 生产环境必须配置，且 SECRET_KEY 与密码不得使用默认值/弱口令（配合 /api/auth/login 的 IP 限流 5/min）
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=

# ── Resume ──
# Max upload size in bytes (default 10MB)
RESUME_MAX_FILE_SIZE=10485760
# Allowed content types (JSON array)
RESUME_ALLOWED_CONTENT_TYPES=["application/pdf","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/markdown"]

# ── Knowledge Base ──
# Max upload size in bytes (default 10MB)
KNOWLEDGE_BASE_MAX_FILE_SIZE=10485760
# Allowed content types (JSON array)
KNOWLEDGE_BASE_ALLOWED_CONTENT_TYPES=["application/pdf","application/msword","application/vnd.openxmlformats-officedocument.wordprocessingml.document","text/plain","text/markdown"]

# ── RAG ──
# 检索最低相关度分数（默认 0.3）
RAG_MIN_SCORE=0.3
# 探测窗口（秒，默认 120）
RAG_PROBE_WINDOW=120
# 查询改写（默认 true）
RAG_QUERY_REWRITE_ENABLED=true
# 上下文最大字符数（默认 6000）
RAG_MAX_CONTEXT_CHARS=6000
# 会话历史条数上限（默认 10）
RAG_HISTORY_LIMIT=10

# ── Agent 模块 ──
# 启用语音面试 AgentDialogueLlm（带 tool-calling），默认 false 不影响现有行为
VOICE_AGENT_ENABLED=false
