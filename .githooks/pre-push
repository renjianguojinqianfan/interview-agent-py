#!/bin/sh
# pre-push: 全量门禁（~90-120s）—— 后端全量 pytest（含 integration/e2e）+ 前端 lint/typecheck/test/build
# 失败阻止 push；这是代码离开本地前的最后自查（CI 为权威终审）。
powershell.exe -NoProfile -Command "Write-Host 'pre-push: running full quality gate...' -ForegroundColor Cyan; uv run --directory backend --frozen alembic upgrade head 2>&1 | Out-Null; if (\$LASTEXITCODE -ne 0) { Write-Host '[warn] Alembic upgrade skipped (DB unavailable); tests will validate schema' -ForegroundColor Yellow }; uv run --directory backend --frozen pytest; if (\$LASTEXITCODE -ne 0) { Write-Host 'Backend tests failed'; exit 1 }; uv run --directory backend --frozen ruff check .; if (\$LASTEXITCODE -ne 0) { Write-Host 'Lint failed'; exit 1 }; uv run --directory backend --frozen ruff format --check .; if (\$LASTEXITCODE -ne 0) { Write-Host 'Format check failed'; exit 1 }; uv run --directory backend --frozen mypy app/; if (\$LASTEXITCODE -ne 0) { Write-Host 'Typecheck failed'; exit 1 }; pnpm --dir frontend run lint; if (\$LASTEXITCODE -ne 0) { Write-Host 'Frontend lint failed'; exit 1 }; pnpm --dir frontend run typecheck; if (\$LASTEXITCODE -ne 0) { Write-Host 'Frontend typecheck failed'; exit 1 }; pnpm --dir frontend run test; if (\$LASTEXITCODE -ne 0) { Write-Host 'Frontend test failed'; exit 1 }; pnpm --dir frontend run build; if (\$LASTEXITCODE -ne 0) { Write-Host 'Frontend build failed'; exit 1 }; Write-Host 'All checks passed - push allowed' -ForegroundColor Green"
